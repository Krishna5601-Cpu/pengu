# Normalize line endings in the repository.
# Without this, Windows checkouts get CRLF, which gofmt reports as
# unformatted and which makes diffs noisy.
* text=auto eol=lf

# Binaries must never be touched
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# Keep shell scripts executable-friendly
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
